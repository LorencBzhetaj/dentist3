# Public URL of the deployed site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://sorer-dental.vercel.app

# Appointment form destination. Without it the form tells visitors to call / use Instagram
# and never shows a fake success. Any endpoint accepting a JSON POST works (Make, Zapier, n8n,
# Formspree, Google Apps Script...).
CONTACT_WEBHOOK_URL=
# Optional bearer token sent to the webhook
CONTACT_WEBHOOK_TOKEN=
